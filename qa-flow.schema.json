{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-flow.local/schema/v2.json",
  "title": "QA Flow Suite",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "suite"],
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": ["action"],
      "properties": {
        "id": { "type": "string", "maxLength": 200 },
        "action": {
          "enum": ["click", "fill", "select", "hover", "assert_visible", "assert_enabled", "assert_disabled", "assert_checked", "assert_unchecked", "assert_text", "assert_value", "assert_attribute", "assert_css", "assert_count", "assert_url", "assert_screenshot", "assert_network_status", "assert_no_console_errors", "assert_a11y", "assert_performance", "assert_security_headers", "api_request", "mock_route", "clear_mocks", "use_flow", "wait", "wait_for_element_hidden", "wait_for_text", "wait_for_url_change", "wait_for_network_idle"]
        },
        "selector": { "type": "string", "maxLength": 5000 },
        "fallbackSelectors": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 5000 } },
        "frame": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "maxLength": 2000 },
            "name": { "type": "string", "maxLength": 120 },
            "isTop": { "type": "boolean" },
            "frameId": { "type": "integer", "minimum": 0 }
          }
        },
        "smart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
            "autoWait": { "enum": ["none", "dom", "url", "network"] },
            "reviewStatus": { "enum": ["pending", "validated", "failed"] },
            "assertionSuggestion": { "type": ["object", "null"] },
            "network": { "type": ["object", "null"] }
          }
        },
        "value": { "type": "string", "maxLength": 20000 },
        "description": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 2000 },
        "enabled": { "type": "boolean" },
        "group": { "type": "string", "maxLength": 120 },
        "timeout": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "performanceThreshold": { "type": "integer", "minimum": 100, "maximum": 120000 },
        "requirementIds": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "maxLength": 120 } },
        "risk": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
        "quarantined": { "type": "boolean" },
        "quarantineOwner": { "type": "string", "maxLength": 120 },
        "quarantineUntil": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "maskSelectors": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
        "maxDiffPixelRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "fullPage": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 2 },
    "environment": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "baseUrl": { "type": "string", "maxLength": 2000 },
        "variables": { "type": "object" }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["rows"],
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "rows": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "object" } }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "owner": { "type": "string", "maxLength": 120 },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "tags": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string", "maxLength": 60 } },
        "startUrl": { "type": "string", "maxLength": 2000 },
        "release": { "type": "string", "maxLength": 120 },
        "requirements": { "type": "array", "maxItems": 500, "items": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 120 }, "title": { "type": "string", "maxLength": 300 }, "risk": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] } } } },
        "beforeEach": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/step" } },
        "steps": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/step" } },
        "afterEach": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/step" } },
        "flows": { "type": "object", "additionalProperties": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/step" } } }
      }
    },
    "defects": { "type": "array", "maxItems": 1000, "items": { "type": "object", "required": ["id", "title", "severity", "status"], "properties": { "id": { "type": "string", "maxLength": 120 }, "title": { "type": "string", "maxLength": 300 }, "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] }, "status": { "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "CLOSED", "WONT_FIX"] } } } },
    "exploratorySessions": { "type": "array", "maxItems": 1000, "items": { "type": "object", "required": ["charter"], "properties": { "charter": { "type": "string", "minLength": 1, "maxLength": 1000 }, "tester": { "type": "string", "maxLength": 120 }, "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 } } } },
    "releaseSignoffs": { "type": "array", "maxItems": 1000, "items": { "type": "object" } }
  }
}
